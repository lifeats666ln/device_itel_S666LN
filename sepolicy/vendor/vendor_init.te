allow vendor_init cgroup:file rw_file_perms;
allow vendor_init proc_printk:file w_file_perms;
allow vendor_init proc_compaction_proactiveness:file w_file_perms;
allow vendor_init proc_watermark_boost_factor:file w_file_perms;

allow vendor_init sysfs_ged:dir search;
allow vendor_init sysfs_ged:file w_file_perms;

allow vendor_init sysfs_dvfsrc_devfreq:dir r_dir_perms;
allow vendor_init sysfs_dvfsrc_devfreq:file rw_file_perms;

allow vendor_init proc_sched:file w_file_perms;
dontaudit vendor_init vendor_userdir_file:dir write;


set_prop(vendor_init, vendor_mtk_audiohal_prop)
set_prop(vendor_init, vendor_mtk_audio_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_mtk_camera_prop)
get_prop(vendor_init, vts_status_prop)
rw_dir_file(vendor_init, sysfs_leds)
allow vendor_init mtk_radio_device:lnk_file unlink;
dontaudit vendor_init bluetooth_prop:property_service set;
dontaudit vendor_init default_prop:property_service set;
rw_dir_file(vendor_init, sysfs_ged)
